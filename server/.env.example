# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# ─── Server Port ──────────────────────────────────────────────────────────────
PORT=5000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Local:      postgresql://postgres:yourpassword@localhost:5432/VentureHub?schema=public
# Railway:    auto-filled by Railway as DATABASE_URL
# Supabase:   get from Supabase dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/VentureHub?schema=public
DIRECT_URL=postgresql://postgres:yourpassword@localhost:5432/VentureHub?schema=public

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Get from https://clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# ─── ImageKit (Media Storage) ─────────────────────────────────────────────────
# Get from https://imagekit.io → Dashboard → Developer Options
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/youraccount

# ─── Inngest (Background Jobs) ───────────────────────────────────────────────
# Get from https://app.inngest.com → your app → Keys
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-prod-...
INNGEST_DEV=0

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
# Get from https://dashboard.stripe.com → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── SMTP Email (Nodemailer) ──────────────────────────────────────────────────
# Gmail: enable 2FA, then generate an App Password from Google Account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_gmail_app_password
SENDER_EMAIL=youremail@gmail.com

# ─── Admin & CORS ─────────────────────────────────────────────────────────────
# Comma-separated admin emails (no spaces)
ADMIN_EMAILS=admin@venturehub.com,youremail@gmail.com

# Frontend URL for CORS (Railway/Vercel deploy URL in production)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
